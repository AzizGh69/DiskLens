<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DiskLens</RootNamespace>
    <AssemblyName>DiskLens</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>DiskLens</Product>
    <Description>Admin disk-space analyzer for Windows</Description>
    <Authors>AzizGh69</Authors>
    <Copyright>Copyright (c) 2026 AzizGh69</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The .NET 9 Fluent theme (ThemeMode) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiskLens.Core\DiskLens.Core.csproj" />
  </ItemGroup>

</Project>

<Window x:Class="DiskLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiskLens"
        Width="1280" Height="820" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Padding="16,20"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="22"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="DiskLens" FontSize="22" FontWeight="SemiBold" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE83D;" FontSize="12" x:Name="AdminIcon"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="AdminText" Style="{StaticResource Caption}" Margin="6,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Page -->
        <Grid Grid.Column="1" Margin="32,24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Your storage" />
        </Grid>
    </Grid>
</Window>

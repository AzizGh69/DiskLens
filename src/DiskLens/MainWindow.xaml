<Window x:Class="DiskLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DiskLens.Controls"
        xmlns:vm="clr-namespace:DiskLens.ViewModels"
        xmlns:views="clr-namespace:DiskLens.Views"
        Title="DiskLens"
        Width="1320" Height="860" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriveViewModel}">
            <views:DriveView />
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Padding="16,20,16,16"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="22"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="DiskLens" FontSize="22" FontWeight="SemiBold" Margin="10,0,0,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE83D;" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="AdminText" Style="{StaticResource Caption}" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="SidebarFooter" DockPanel.Dock="Bottom" />

                <ListBox Margin="-8,20,-8,12" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Resources>
                        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
                            <StackPanel Orientation="Horizontal" Margin="4,8">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" />
                                <TextBlock Style="{StaticResource Body}" Text="Overview" Margin="12,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:DriveViewModel}">
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding Title}" />
                                    <c:UsageBar Style="{StaticResource LowAwareUsageBar}" Used="{Binding Used}" Total="{Binding Total}"
                                                Height="4" Margin="0,6,0,4" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding SidebarCaption}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Info banner (e.g. after handing an app to Revo Uninstaller) -->
            <Border Grid.Row="0" Margin="32,16,32,0" Padding="14,10" CornerRadius="6"
                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Padding="8,2" Command="{Binding DismissBannerCommand}" ToolTip="Dismiss">
                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE711;" Margin="0" FontSize="10" />
                    </Button>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,10,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Body}" Text="{Binding BannerText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding SelectedPage}" Focusable="False" />

            <TextBlock Grid.Row="1" Style="{StaticResource Caption}" FontSize="14" Text="Reading your disks…"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</Window>

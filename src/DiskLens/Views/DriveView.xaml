<UserControl x:Class="DiskLens.Views.DriveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DiskLens.Controls"
             xmlns:vm="clr-namespace:DiskLens.ViewModels">
    <UserControl.Resources>
        <!-- Quick-answer card -->
        <DataTemplate x:Key="AnswerCard" DataType="{x:Type vm:AnswerCardViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="14"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="8,0,0,0" Text="{Binding Caption}" />
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,5"
                            Content="{Binding ActionText}" Command="{Binding Action}"
                            Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />

                    <Grid>
                        <StackPanel Visibility="{Binding HasValue, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource BigNumber}" Margin="0,8,0,2" Text="{Binding Value}" />
                            <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding Name}" ToolTip="{Binding Name}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" ToolTip="{Binding Detail}" Margin="0,2,0,0" />
                            <ItemsControl ItemsSource="{Binding RunnersUp}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding}" ToolTip="{Binding}" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding EmptyText}">
                            <TextBlock.Visibility>
                                <Binding Path="HasValue" Converter="{StaticResource InverseBoolToVisibility}" />
                            </TextBlock.Visibility>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Right-click menu shared by every list on this page -->
        <ContextMenu x:Key="RowMenu" x:Shared="False">
            <MenuItem Header="Move to Recycle Bin…" ToolTipService.ShowOnDisabled="True"
                      ToolTip="{Binding PlacementTarget.SelectedItem.BlockReason, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue='Select an item first', TargetNullValue='You can restore it from the Recycle Bin later'}"
                      Command="{Binding PlacementTarget.DataContext.RecycleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE74D;" Margin="0" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Show in Explorer"
                      Command="{Binding PlacementTarget.DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE838;" Margin="0" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy path"
                      Command="{Binding PlacementTarget.DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE8C8;" Margin="0" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Right-click menu for the Apps list -->
        <ContextMenu x:Key="AppMenu" x:Shared="False">
            <MenuItem Header="{Binding PlacementTarget.DataContext.UninstallActionText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Command="{Binding PlacementTarget.DataContext.UninstallWithRevoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE74D;" Margin="0" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Show in Explorer"
                      Command="{Binding PlacementTarget.DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE838;" Margin="0" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy path"
                      Command="{Binding PlacementTarget.DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon><TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE8C8;" Margin="0" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <Style x:Key="ResultList" TargetType="ListView" BasedOn="{StaticResource GridList}">
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
            <EventSetter Event="MouseDoubleClick" Handler="List_MouseDoubleClick" />
            <EventSetter Event="KeyDown" Handler="List_KeyDown" />
        </Style>

        <!-- Small toolbar button with an icon -->
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">

            <!-- Header -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Padding="14,8" Margin="0,0,8,0" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE711;" />
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </Button>
                    <Button Padding="14,8" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" Command="{Binding ScanCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE72C;" />
                            <TextBlock Text="{Binding ScanButtonText}" />
                        </StackPanel>
                    </Button>
                    <Button Padding="14,8" Command="{Binding OpenInExplorerCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE838;" />
                            <TextBlock Text="Open in Explorer" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="14" Margin="0,4,0,0" Text="{Binding Details}" />
                </StackPanel>
            </DockPanel>

            <!-- Capacity -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <c:UsageBar Style="{StaticResource LowAwareUsageBar}" Used="{Binding Used}" Total="{Binding Total}" Height="12" />
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    Visibility="{Binding IsLow, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Foreground="{DynamicResource Status.Critical}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="6,0,0,0" Text="Almost full — less than 10% free" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding UsageText}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Error -->
            <Border Margin="0,16,0,0" Padding="14,10" CornerRadius="6"
                    Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Text="{Binding ErrorText}" />
            </Border>

            <!-- Not scanned yet -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="32"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="36" HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,12,0,4">
                        <Run Text="Find out what's taking space on" /> <Run Text="{Binding Letter, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560"
                               Text="DiskLens reads every folder on this drive and tells you the heaviest file, folder, app and system item. It only reads — nothing is changed." />
                    <Button HorizontalAlignment="Center" Margin="0,18,0,0" Padding="20,8" Style="{DynamicResource AccentButtonStyle}"
                            Command="{Binding ScanCommand}" Content="Scan this drive" />
                </StackPanel>
            </Border>

            <!-- Scanning -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource BodyStrong}">
                            <Run Text="{Binding ProgressPercent, StringFormat={}{0:0}, Mode=OneWay}" /><Run Text="%" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyStrong}" Text="Scanning…" />
                    </DockPanel>
                    <ProgressBar Margin="0,10,0,10" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding ProgressText}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding ProgressPath}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Results -->
            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">

                <TextBlock Style="{StaticResource SectionTitle}" Text="Quick answers" Margin="0,24,0,10" />
                <UniformGrid Columns="4" Margin="0,0,-12,0">
                    <ContentControl Content="{Binding HeaviestFile}" ContentTemplate="{StaticResource AnswerCard}" Focusable="False" />
                    <ContentControl Content="{Binding HeaviestFolder}" ContentTemplate="{StaticResource AnswerCard}" Focusable="False" />
                    <ContentControl Content="{Binding HeaviestApp}" ContentTemplate="{StaticResource AnswerCard}" Focusable="False" />
                    <ContentControl Content="{Binding BiggestSystemItem}" ContentTemplate="{StaticResource AnswerCard}" Focusable="False" />
                </UniformGrid>

                <TextBlock Style="{StaticResource SectionTitle}" Text="Where your space goes" Margin="0,24,0,10" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Categories}" Height="28">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <c:WeightPanel Spacing="2" MinItemWidth="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="c:WeightPanel.Weight" Value="{Binding Weight}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CategorySliceViewModel}">
                                    <Border CornerRadius="4" Background="{Binding Brush}" ToolTip="{Binding ToolTip}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Categories}" Margin="0,16,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CategorySliceViewModel}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,28,8" ToolTip="{Binding Description}"
                                                Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                                        <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Brush}" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource Body}" Margin="8,0,0,0" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource Caption}" FontSize="14" Margin="8,0,0,0" Text="{Binding ValueText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TabControl Margin="0,24,0,0" Height="620" SelectedIndex="{Binding SelectedTab}">

                    <!-- Largest files -->
                    <TabItem Header="Largest files">
                        <DockPanel Margin="0,12,0,0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding RecycleCommand}"
                                            CommandParameter="{Binding SelectedItem, ElementName=FilesList}"
                                            ToolTipService.ShowOnDisabled="True"
                                            ToolTip="{Binding SelectedItem.BlockReason, ElementName=FilesList, FallbackValue='Select an item first', TargetNullValue='Move the selected item to the Recycle Bin (you can restore it later)'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE74D;" />
                                            <TextBlock Text="Move to Recycle Bin" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ShowInExplorerCommand}"
                                            CommandParameter="{Binding SelectedItem, ElementName=FilesList}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE838;" />
                                            <TextBlock Text="Show in Explorer" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding CopyPathCommand}"
                                            CommandParameter="{Binding SelectedItem, ElementName=FilesList}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE8C8;" />
                                            <TextBlock Text="Copy path" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Caption}" FontSize="14" VerticalAlignment="Center" Text="Show" />
                                <ComboBox Width="300" Margin="10,0,0,0" ItemsSource="{Binding TypeFilters}"
                                          SelectedItem="{Binding SelectedTypeFilter}" DisplayMemberPath="Label" />
                                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Text="from the 500 largest files on this drive" />
                            </DockPanel>

                            <ListView x:Name="FilesList" Style="{StaticResource ResultList}" ItemsSource="{Binding Files}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Name" Width="330">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}">
                                                        <TextBlock Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" Text="{Binding Glyph}" />
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Size" Width="190">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Width="72" Text="{Binding SizeText}" />
                                                        <ProgressBar Style="{StaticResource ShareBar}" Width="90" Value="{Binding Percent, Mode=OneWay}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Type" Width="150" DisplayMemberBinding="{Binding Group}" />
                                        <GridViewColumn Header="Modified" Width="110" DisplayMemberBinding="{Binding ModifiedText}" />
                                        <GridViewColumn Header="Folder" Width="520" DisplayMemberBinding="{Binding Folder}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </TabItem>

                    <!-- Folders -->
                    <TabItem Header="Folders">
                        <DockPanel Margin="0,12,0,0">
                            <DockPanel DockPanel.Dock="Top">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding RecycleCommand}"
                                            CommandParameter="{Binding SelectedItem, ElementName=FoldersList}"
                                            ToolTipService.ShowOnDisabled="True"
                                            ToolTip="{Binding SelectedItem.BlockReason, ElementName=FoldersList, FallbackValue='Select an item first', TargetNullValue='Move the selected item to the Recycle Bin (you can restore it later)'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE74D;" />
                                            <TextBlock Text="Move to Recycle Bin" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ShowInExplorerCommand}"
                                            CommandParameter="{Binding SelectedItem, ElementName=FoldersList}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE838;" />
                                            <TextBlock Text="Show in Explorer" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding CopyPathCommand}"
                                            CommandParameter="{Binding SelectedItem, ElementName=FoldersList}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE8C8;" />
                                            <TextBlock Text="Copy path" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <Button Padding="10,5" Command="{Binding Browser.UpCommand}" ToolTip="Up one level">
                                    <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE74A;" Margin="0" />
                                </Button>
                                <ItemsControl ItemsSource="{Binding Browser.Breadcrumbs}" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Padding="6,3" Background="Transparent" BorderThickness="0" Content="{Binding Name}"
                                                        Command="{Binding DataContext.Browser.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Style="{StaticResource Icon}" FontSize="10" Margin="2,0" Text="&#xE76C;"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="2,8,0,8" Text="{Binding Browser.Summary}" />

                            <ListView x:Name="FoldersList" Style="{StaticResource ResultList}" ItemsSource="{Binding Browser.Items}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Name" Width="380">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}">
                                                        <TextBlock Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" Text="{Binding Glyph}" />
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Size" Width="110" DisplayMemberBinding="{Binding SizeText}" />
                                        <GridViewColumn Header="Share of this folder" Width="220">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ProgressBar Style="{StaticResource ShareBar}" Width="130" Value="{Binding Percent, Mode=OneWay}" />
                                                        <TextBlock Margin="10,0,0,0" Text="{Binding PercentText}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Contents" Width="360" DisplayMemberBinding="{Binding Details}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </TabItem>

                    <!-- Apps -->
                    <TabItem Header="Apps">
                        <DockPanel Margin="0,12,0,0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding UninstallWithRevoCommand}"
                                            CommandParameter="{Binding SelectedItem, ElementName=AppsList}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE74D;" />
                                            <TextBlock Text="{Binding UninstallActionText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ShowInExplorerCommand}"
                                            CommandParameter="{Binding SelectedItem, ElementName=AppsList}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE838;" />
                                            <TextBlock Text="Show in Explorer" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding CopyPathCommand}"
                                            CommandParameter="{Binding SelectedItem, ElementName=AppsList}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE8C8;" />
                                            <TextBlock Text="Copy path" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Caption}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="{Binding AppsSummary}" />
                            </DockPanel>

                            <ListView x:Name="AppsList" Style="{StaticResource ResultList}" ItemsSource="{Binding Apps}"
                                      ContextMenu="{StaticResource AppMenu}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Name" Width="340">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Name}">
                                                        <TextBlock Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" Text="{Binding Glyph}" />
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Size" Width="200">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding SizeToolTip}">
                                                        <TextBlock Width="84" Text="{Binding SizeText}" />
                                                        <ProgressBar Style="{StaticResource ShareBar}" Width="90" Value="{Binding Percent, Mode=OneWay}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Publisher" Width="200" DisplayMemberBinding="{Binding Publisher}" />
                                        <GridViewColumn Header="Version" Width="120" DisplayMemberBinding="{Binding Version}" />
                                        <GridViewColumn Header="Folder" Width="480">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Location}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasLocation}" Value="False">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </TabItem>

                    <!-- System -->
                    <TabItem Header="System">
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" FontSize="14" Margin="0,0,0,10"
                                       TextWrapping="Wrap" Text="{Binding SystemSummary}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding SystemItems}" Margin="0,0,8,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SystemItemViewModel}">
                                            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,2,0,0" FontSize="18"
                                                               Text="{Binding Glyph}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />

                                                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                                        <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding Name}" />
                                                        <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding WhatItIs}" />
                                                        <DockPanel Margin="0,8,0,0">
                                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="12" VerticalAlignment="Top" Margin="0,2,8,0"
                                                                       Text="&#xE82F;" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Text="{Binding Tip}" />
                                                        </DockPanel>
                                                        <DockPanel Margin="0,6,0,0" Visibility="{Binding HasSizeNote, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="12" VerticalAlignment="Top" Margin="0,2,8,0"
                                                                       Text="&#xE946;" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" Text="{Binding SizeNote}" />
                                                        </DockPanel>
                                                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding FullPath}" ToolTip="{Binding FullPath}"
                                                                   Visibility="{Binding HasPath, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,0,16,0">
                                                        <TextBlock Style="{StaticResource BodyStrong}" FontSize="18" Text="{Binding SizeText}" />
                                                        <ProgressBar Style="{StaticResource ShareBar}" Margin="0,8,0,0" Value="{Binding Percent, Mode=OneWay}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" VerticalAlignment="Top" MinWidth="190">
                                                        <Button HorizontalAlignment="Stretch" Padding="12,5" Content="{Binding ActionText}"
                                                                Command="{Binding DataContext.RunSystemActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                                                        <Button HorizontalAlignment="Stretch" Padding="12,5" Margin="0,6,0,0"
                                                                Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding HasPath, Converter={StaticResource BoolToVisibility}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE838;" />
                                                                <TextBlock Text="Show in Explorer" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                </TabControl>

                <TextBlock Style="{StaticResource Caption}" Margin="2,16,0,0" TextWrapping="Wrap" Text="{Binding ResultSummary}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="DiskLens.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DiskLens.Controls"
             xmlns:vm="clr-namespace:DiskLens.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">

            <!-- Header -->
            <DockPanel>
                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Padding="16,8"
                        Style="{DynamicResource AccentButtonStyle}" Command="{Binding ScanAllCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE721;" />
                        <TextBlock Text="Scan all drives" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Your storage" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="14" Margin="0,4,0,0" Text="{Binding Summary}" />
                </StackPanel>
            </DockPanel>

            <!-- Drives -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Drives" Margin="0,28,0,10" />
            <ItemsControl ItemsSource="{Binding Drives}" Margin="0,0,-12,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DriveViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="28" Margin="0,0,14,0" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BodyStrong}" FontSize="16" Text="{Binding Title}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Details}" ToolTip="{Binding Details}" />
                                    </StackPanel>
                                </DockPanel>
                                <c:UsageBar Style="{StaticResource LowAwareUsageBar}" Used="{Binding Used}" Total="{Binding Total}"
                                            Height="8" Margin="0,14,0,8" ToolTip="{Binding UsageText}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding UsageText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                            Visibility="{Binding IsLow, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Foreground="{DynamicResource Status.Critical}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="6,0,0,0" Text="Almost full — less than 10% free" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Style="{DynamicResource AccentButtonStyle}" Padding="16,6" Content="{Binding ScanButtonText}"
                                            Command="{Binding DataContext.ScanDriveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Margin="8,0,0,0" Padding="16,6" Content="Open"
                                            Command="{Binding DataContext.OpenDriveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Disks & partitions -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Disks &amp; partitions" Margin="0,16,0,4" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12" TextWrapping="Wrap"
                       Text="Each box is a partition, sized to scale (very small ones are widened so you can read them). Hover for details." />
            <TextBlock Margin="0,0,0,12" Text="{Binding PartitionError}" Foreground="{DynamicResource Status.Critical}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PartitionError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding Disks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DiskViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE950;" FontSize="20" Margin="0,0,12,0" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding Title}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Subtitle}" />
                                    </StackPanel>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding Segments}" Margin="0,14,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <c:WeightPanel Spacing="4" MinItemWidth="104" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="c:WeightPanel.Weight" Value="{Binding Weight}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PartitionViewModel}">
                                            <Border Height="74" Padding="10,8" CornerRadius="6" ToolTip="{Binding ToolTip}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWindows}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsUnallocated}" Value="True">
                                                                <Setter Property="Background" Value="Transparent" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <DockPanel>
                                                    <c:UsageBar DockPanel.Dock="Bottom" Height="6" Used="{Binding Used}" Total="{Binding Total}"
                                                                Visibility="{Binding HasUsage, Converter={StaticResource BoolToVisibility}}" />
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource BodyStrong}" Text="{Binding Name}" />
                                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Caption}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Legend for the bars inside partitions -->
            <StackPanel Orientation="Horizontal" Margin="2,2,0,0">
                <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource Bar.Used}" />
                <TextBlock Style="{StaticResource Caption}" Text="Used space" Margin="6,0,16,0" VerticalAlignment="Center" />
                <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource Bar.Free}" />
                <TextBlock Style="{StaticResource Caption}" Text="Free space" Margin="6,0,16,0" VerticalAlignment="Center" />
                <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource Status.Critical}" />
                <TextBlock Style="{StaticResource Caption}" Text="Used space on a drive that's almost full" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
